# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used only in lib/supabase/admin.ts
# for actions that must bypass RLS (e.g. writing audit_logs).
SUPABASE_SERVICE_ROLE_KEY=

# --- Existing Wildenroth Tippspiel project (optional, read-only) -----------
# Enables lib/providers/match-data/existing-tippspiel-provider.ts. Point this
# at the Tippspiel project's own Supabase instance with a READ-ONLY anon key
# — never the service role. Leave empty to disable this provider (the app
# falls back to manual entry / CSV import).
TIPPSPIEL_SUPABASE_URL=
TIPPSPIEL_SUPABASE_ANON_KEY=

# --- AI provider (all optional — the app works fully without any of this) --
# 'none' | 'local_vision' | 'anthropic'. Leave unset to auto-detect (prefers
# a configured local model over a configured cloud provider, else 'none').
AI_PROVIDER=

# LocalVisionProvider: any OpenAI-chat-completions-compatible endpoint
# (LM Studio, Ollama's OpenAI-compat layer, vLLM, ...).
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=

# AnthropicProvider (optional, paid).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
